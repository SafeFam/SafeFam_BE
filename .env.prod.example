# PostgreSQL
POSTGRES_DB=safefam
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATA_PATH=/opt/safefam/volumes/postgres

# RabbitMQ
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_DATA_PATH=/opt/safefam/volumes/rabbitmq
# Percent-encode reserved URI characters in the username and password.
RABBITMQ_URL=amqp://username:password@rabbitmq:5672/

# JWT
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Outbox
OUTBOX_ENCRYPTION_KEY_BASE64=

# Kakao
KAKAO_CLIENT_ID=

# Solapi
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# Firebase
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=/opt/safefam/secrets/firebase-service-account.json

# AI external APIs
GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Spring -> FastAPI chat bridge
AI_CHAT_BASE_URL=http://fastapi-ai:8000
AI_CHAT_CONNECT_TIMEOUT=3s
AI_CHAT_READ_TIMEOUT=60s

# Analysis messaging
ANALYSIS_PUBLISHER_ENABLED=true
ANALYSIS_CONSUMER_ENABLED=true
AI_RABBITMQ_CONSUMER_ENABLED=true
AI_RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=5
RABBITMQ_SHUTDOWN_TIMEOUT_SECONDS=30
RABBITMQ_REQUEUE_BACKOFF_SECONDS=1

# Redis
REDIS_PASSWORD=localdevpassword
