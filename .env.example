# PostgreSQL
POSTGRES_DB=safefam
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USERNAME=safefam
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Published ports
SPRING_PORT=8080
FASTAPI_PORT=8000
NGINX_PORT=80

# Spring authentication and encrypted outbox
JWT_SECRET=replace-with-a-secure-base64-secret
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
OUTBOX_ENCRYPTION_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key

# Spring external integrations
KAKAO_CLIENT_ID=replace-me
SOLAPI_API_KEY=replace-me
SOLAPI_API_SECRET=replace-me
SOLAPI_SENDER=01000000000
FIREBASE_SERVICE_ACCOUNT_PATH=test

# FastAPI external integrations
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Analysis messaging
ANALYSIS_PUBLISHER_ENABLED=true
ANALYSIS_CONSUMER_ENABLED=true
AI_RABBITMQ_CONSUMER_ENABLED=true
AI_RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=5
RABBITMQ_SHUTDOWN_TIMEOUT_SECONDS=30
RABBITMQ_REQUEUE_BACKOFF_SECONDS=1
