# Spring profile
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL
POSTGRES_DB=safefam
POSTGRES_USER=
POSTGRES_PASSWORD=

# RabbitMQ
RABBITMQ_URL=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Authentication
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Outbox
OUTBOX_ENCRYPTION_KEY_BASE64=

# External integrations
KAKAO_CLIENT_ID=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=/opt/safefam/secrets/firebase-service-account.json

# FastAPI chat bridge
AI_CHAT_BASE_URL=http://fastapi-ai:8000
AI_CHAT_CONNECT_TIMEOUT=3s
AI_CHAT_READ_TIMEOUT=60s

# Messaging
ANALYSIS_PUBLISHER_ENABLED=true
ANALYSIS_CONSUMER_ENABLED=true
ANALYSIS_PUBLISHER_DELAY=1000

# Redis
REDIS_PASSWORD=localdevpassword