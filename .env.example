# Spring profile
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# RabbitMQ
RABBITMQ_URL=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Authentication
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Outbox
OUTBOX_ENCRYPTION_KEY_BASE64=

# External integrations
KAKAO_CLIENT_ID=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase/service-account.json

# Messaging
ANALYSIS_PUBLISHER_ENABLED=true
ANALYSIS_CONSUMER_ENABLED=true
ANALYSIS_PUBLISHER_DELAY=1000
